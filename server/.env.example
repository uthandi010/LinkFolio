# Copy to .env and adjust as needed. All variables are prefixed LINKFOLIO_
# (see app/config.py). Every value below has a working default already, so
# this file is optional for local development.

# LINKFOLIO_DATABASE_URL=sqlite:///./linkfolio.db
# LINKFOLIO_SECRET_KEY=change-me-to-a-long-random-string-in-production
# LINKFOLIO_ACCESS_TOKEN_EXPIRE_MINUTES=10080
